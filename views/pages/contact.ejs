<%
    // Shared classes so an errored field is visually and programmatically distinct.
    var base = 'w-full px-4 py-2.5 border rounded-lg text-sm outline-none transition focus:ring-2 focus:ring-brand-primary';
    var ok = base + ' border-slate-200';
    var bad = base + ' border-red-400 bg-red-50 focus:ring-red-400';
    function fieldClass(name) { return errors[name] ? bad : ok; }
%>

<div class="py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-12">

        <!-- Direct Reach Out Channels -->
        <div class="md:col-span-5 space-y-6">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Direct Reach Out</span>
                <h1 class="font-heading text-3xl font-extrabold text-slate-900 mt-1">Request Your Quote</h1>
                <p class="text-slate-600 mt-3 leading-relaxed">Send your project details and I'll reply by email. Prefer to talk it through? WhatsApp works just as well.</p>
            </div>

            <%- include('../partials/trust') %>

            <div class="space-y-4 pt-4 border-t border-slate-200">
                <!-- WhatsApp Card -->
                <a href="<%= site.whatsappLink("Hi Nolundi, I'd like to discuss a new website project.") %>"
                   target="_blank" rel="noopener"
                   class="flex items-center space-x-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl hover:bg-emerald-100 transition">
                    <%- include('../partials/icon', { name: 'whatsapp', cls: 'w-8 h-8 text-emerald-600' }) %>
                    <div>
                        <p class="text-sm font-bold text-slate-900">Direct WhatsApp</p>
                        <p class="text-sm text-slate-600"><%= site.whatsappDisplay %> — click to start an immediate chat</p>
                    </div>
                </a>

                <!-- Direct Email Card -->
                <a href="<%= site.emailLink %>" class="flex items-center space-x-4 p-4 bg-white border border-slate-200 rounded-xl hover:border-brand-primary transition shadow-sm">
                    <%- include('../partials/icon', { name: 'envelope', cls: 'w-7 h-7 text-brand-primary' }) %>
                    <div>
                        <p class="text-sm font-bold text-slate-900">Direct Email</p>
                        <p class="text-sm text-brand-primary font-medium"><%= site.email %></p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Quote Request Form -->
        <div class="md:col-span-7 bg-white p-8 rounded-2xl shadow-lg border border-slate-200">

            <!-- Form-level error. role=alert so screen readers announce it on
                 the no-JS render; JS moves focus here too. -->
            <div id="formError"
                 role="alert"
                 tabindex="-1"
                 class="<%= formError ? '' : 'hidden' %> mb-5 rounded-lg border border-red-200 bg-red-50 p-4">
                <p class="text-sm font-semibold text-red-800" id="formErrorText"><%= formError || '' %></p>
                <a id="formErrorWhatsapp"
                   href="<%= site.whatsappLink("Hi Nolundi, the contact form on your site didn't go through. Here are my project details:") %>"
                   target="_blank" rel="noopener"
                   class="mt-2 inline-flex items-center gap-2 text-sm font-bold text-emerald-700 underline hover:text-emerald-800">
                    <%- include('../partials/icon', { name: 'whatsapp', cls: 'w-4 h-4' }) %> Send it on WhatsApp instead
                </a>
            </div>

            <form id="quoteForm"
                  method="POST"
                  action="/contact"
                  class="space-y-4"
                  data-whatsapp="<%= site.whatsappNumber %>"
                  novalidate>

                <!-- Bot traps. `company_website` is invisible to humans and
                     skipped by keyboard and screen reader; anything filling it
                     is automated. `form_started_at` catches instant submits. -->
                <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
                    <label for="company_website">Company website (leave this blank)</label>
                    <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off">
                </div>
                <input type="hidden" name="form_started_at" value="<%= Date.now() %>">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="clientName" class="block text-xs font-bold uppercase text-slate-700 mb-1">
                            Your Name <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                        <input type="text" id="clientName" name="name" required autocomplete="name"
                               value="<%= values.name || '' %>"
                               placeholder="e.g. Sipho"
                               class="<%= fieldClass('name') %>"
                               <%= errors.name ? 'aria-invalid="true" aria-describedby="err-name"' : '' %>>
                        <p id="err-name" class="mt-1 text-xs font-medium text-red-700 <%= errors.name ? '' : 'hidden' %>"><%= errors.name || '' %></p>
                    </div>
                    <div>
                        <label for="businessName" class="block text-xs font-bold uppercase text-slate-700 mb-1">Business Name</label>
                        <input type="text" id="businessName" name="business" autocomplete="organization"
                               value="<%= values.business || '' %>"
                               placeholder="e.g. Apex Mechanics"
                               class="<%= fieldClass('business') %>"
                               <%= errors.business ? 'aria-invalid="true" aria-describedby="err-business"' : '' %>>
                        <p id="err-business" class="mt-1 text-xs font-medium text-red-700 <%= errors.business ? '' : 'hidden' %>"><%= errors.business || '' %></p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="clientEmail" class="block text-xs font-bold uppercase text-slate-700 mb-1">
                            Email <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                        <input type="email" id="clientEmail" name="email" required autocomplete="email"
                               value="<%= values.email || '' %>"
                               placeholder="you@example.com"
                               class="<%= fieldClass('email') %>"
                               <%= errors.email ? 'aria-invalid="true" aria-describedby="err-email"' : '' %>>
                        <p id="err-email" class="mt-1 text-xs font-medium text-red-700 <%= errors.email ? '' : 'hidden' %>"><%= errors.email || '' %></p>
                    </div>
                    <div>
                        <label for="clientPhone" class="block text-xs font-bold uppercase text-slate-700 mb-1">
                            Phone <span class="font-medium normal-case text-slate-400">(optional)</span>
                        </label>
                        <input type="tel" id="clientPhone" name="phone" autocomplete="tel"
                               value="<%= values.phone || '' %>"
                               placeholder="060 000 0000"
                               class="<%= fieldClass('phone') %>"
                               <%= errors.phone ? 'aria-invalid="true" aria-describedby="err-phone"' : '' %>>
                        <p id="err-phone" class="mt-1 text-xs font-medium text-red-700 <%= errors.phone ? '' : 'hidden' %>"><%= errors.phone || '' %></p>
                    </div>
                </div>

                <div>
                    <label for="packageTier" class="block text-xs font-bold uppercase text-slate-700 mb-1">Package / Service</label>
                    <select id="packageTier" name="tier" required
                            class="<%= fieldClass('tier') %> text-slate-700"
                            <%= errors.tier ? 'aria-invalid="true" aria-describedby="err-tier"' : '' %>>
                        <% tiers.forEach(function (tier) { %>
                            <option value="<%= tier.slug %>" <%= selectedTier === tier.slug ? 'selected' : '' %>><%= tier.optionLabel %></option>
                        <% }); %>
                    </select>
                    <p id="err-tier" class="mt-1 text-xs font-medium text-red-700 <%= errors.tier ? '' : 'hidden' %>"><%= errors.tier || '' %></p>
                </div>

                <div>
                    <label for="projectNotes" class="block text-xs font-bold uppercase text-slate-700 mb-1">Project Details</label>
                    <textarea id="projectNotes" name="notes" rows="4"
                              placeholder="Briefly describe what your business does and any special requirements..."
                              class="<%= fieldClass('notes') %>"
                              <%= errors.notes ? 'aria-invalid="true" aria-describedby="err-notes"' : '' %>><%= values.notes || '' %></textarea>
                    <p id="err-notes" class="mt-1 text-xs font-medium text-red-700 <%= errors.notes ? '' : 'hidden' %>"><%= errors.notes || '' %></p>
                </div>

                <button type="submit" id="quoteSubmit"
                        class="w-full bg-brand-primary hover:bg-blue-700 disabled:bg-slate-400 disabled:cursor-not-allowed text-white font-bold py-3.5 rounded-lg shadow text-xs tracking-wider uppercase transition flex items-center justify-center gap-2">
                    <span id="quoteSubmitIdle" class="flex items-center gap-2">
                        <%- include('../partials/icon', { name: 'paper-plane', cls: 'w-4 h-4' }) %> Send Enquiry
                    </span>
                    <span id="quoteSubmitBusy" class="hidden items-center gap-2">
                        <%- include('../partials/icon', { name: 'circle-notch', cls: 'w-4 h-4 animate-spin motion-reduce:animate-none' }) %> Sending…
                    </span>
                </button>

                <!-- Live region: announces submit progress to screen readers. -->
                <p id="quoteStatus" class="sr-only" role="status" aria-live="polite"></p>

                <p class="text-center text-xs text-slate-500 pt-1">
                    Prefer WhatsApp?
                    <a id="whatsappFallback"
                       href="<%= site.whatsappLink("Hi Nolundi, I'd like to request a project quote.") %>"
                       target="_blank" rel="noopener"
                       class="font-semibold text-emerald-700 underline hover:text-emerald-800">
                        Send these details as a message instead
                    </a>
                </p>
            </form>
        </div>

    </div>
</div>

<script src="/js/contact.js" defer></script>
