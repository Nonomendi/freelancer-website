<section class="bg-brand-dark text-white py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
        <span class="text-brand-accent font-bold text-xs uppercase tracking-widest">Packages</span>
        <h1 class="font-heading text-4xl sm:text-5xl font-extrabold mt-3 leading-tight tracking-tight">Service Tiers &amp; Development Packages</h1>
        <p class="text-slate-300 mt-4 text-lg leading-relaxed">Clear packages designed for local small businesses, growing companies, and Salesforce projects.</p>

        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-400">
            <% if (site.trust.responseTime) { %>
                <li class="flex items-center gap-1.5"><%- include('../partials/icon', { name: 'clock', cls: 'w-4 h-4 text-brand-accent' }) %><%= site.trust.responseTime %></li>
            <% } %>
            <li class="flex items-center gap-1.5"><%- include('../partials/icon', { name: 'shield-halved', cls: 'w-4 h-4 text-emerald-400' }) %><%= site.trust.noPayment %></li>
            <li class="flex items-center gap-1.5"><%- include('../partials/icon', { name: 'location-dot', cls: 'w-4 h-4 text-brand-accent' }) %><%= site.trust.location %></li>
        </ul>
    </div>
</section>

<!-- PACKAGES GRID -->
<section class="py-20 max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <% tiers.forEach(function (tier) { %>
            <div class="bg-white rounded-2xl p-8 flex flex-col justify-between h-full <%= tier.featured ? 'border-2 border-brand-primary shadow-xl relative md:-mt-4 md:pb-12' : 'border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-1 motion-reduce:hover:translate-y-0 transition duration-300' %>"
                 data-reveal>
                <% if (tier.badge) { %>
                    <span class="absolute -top-3 right-6 bg-brand-primary text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"><%= tier.badge %></span>
                <% } %>
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider <%= tier.featured ? 'text-brand-accent' : 'text-brand-primary' %>"><%= tier.number %></span>
                    <h2 class="font-heading text-2xl font-bold text-slate-900 mt-2"><%= tier.name %></h2>
                    <p class="text-slate-600 mt-3 leading-relaxed"><%= tier.description %></p>

                    <% if (tier.turnaround) { %>
                        <p class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1">
                            <%- include('../partials/icon', { name: 'clock', cls: 'w-4 h-4' }) %> <%= tier.turnaround %> turnaround
                        </p>
                    <% } %>

                    <ul class="mt-6 space-y-3 text-sm text-slate-700 border-t border-slate-100 pt-6">
                        <% tier.features.forEach(function (feature) { %>
                            <li class="flex items-start gap-2.5">
                                <%- include('../partials/icon', { name: 'check', cls: 'w-3.5 h-3.5 text-emerald-600 mt-1' }) %>
                                <span><%= feature %></span>
                            </li>
                        <% }); %>
                    </ul>
                </div>
                <div class="mt-8 pt-6 border-t border-slate-100">
                    <a href="/contact?tier=<%= tier.slug %>"
                       class="block text-center w-full text-white font-bold py-3.5 rounded-lg text-xs uppercase tracking-wider transition <%= tier.featured ? 'bg-brand-primary hover:bg-blue-700 shadow-lg' : 'bg-slate-900 hover:bg-brand-primary' %>">Select <%= tier.number %></a>
                </div>
            </div>
        <% }); %>
    </div>

    <p class="text-center text-sm text-slate-500 mt-10" data-reveal>
        Not sure which fits? <a href="/contact" class="text-brand-primary font-semibold underline hover:text-blue-700">Describe your project</a>
        and you'll get a recommendation with a fixed quote — no payment until you approve it.
    </p>
</section>
