{
  "name": "nolundi-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Nolundi Mendi — Full Stack & Salesforce Developer, Johannesburg",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n css,server -c cyan,green \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "dev:server": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "build": "npm run build:css",
    "start": "node server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.3"
  }
}
